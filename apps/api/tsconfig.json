{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "paths": {
      "@calendly/types": ["../../packages/types/src"],
      "@calendly/core": ["../../packages/core/src"]
    }
  },
  "include": ["src/**/*"]
}
