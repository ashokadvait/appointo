# PostgreSQL connection string (direct, used by Prisma CLI)
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Optional pooled connection string for serverless runtime (set automatically by Prisma Postgres on Vercel)
# DATABASE_URL_POOLED=""

# Secret used to sign JWT auth tokens
JWT_SECRET="replace-with-a-secure-random-secret"

